#!/usr/bin/env python3
"""Safely inventory or remove unreferenced Project Plateau build evidence.

Dry-run is the default.  A file can only be removed when it is below
``build/evidence`` and no authoritative root or transitively referenced JSON
document binds it.  This intentionally favours a false keep over evidence loss.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
from typing import Iterable


PATH_PATTERN = re.compile(r"(?:build/)?evidence/[A-Za-z0-9_./-]+")
ROOT_DOCUMENTS = (
    "qa/release-gates.json",
    "qa/verification.json",
    "qa/QA_REPORT.md",
    "build/asset-ledger.json",
)


class EvidenceRetentionError(RuntimeError):
    """Block inventory and deletion when the authority graph is not trustworthy."""


def evidence_path(project: Path, value: str) -> Path | None:
    clean = value.split("#", 1)[0].rstrip(".,:;)'\"]}")
    if clean.startswith("build/evidence/"):
        candidate = project / clean
    elif clean.startswith("evidence/"):
        candidate = project / "build" / clean
    else:
        return None
    try:
        candidate.resolve().relative_to((project / "build" / "evidence").resolve())
    except ValueError:
        return None
    return candidate.absolute()


def strings(value: object) -> Iterable[str]:
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from strings(item)


def references(document: Path, project: Path) -> set[Path]:
    try:
        if document.suffix == ".json":
            payload = json.loads(document.read_text(encoding="utf-8"))
            if not isinstance(payload, dict):
                raise EvidenceRetentionError(
                    f"authoritative JSON must be an object: {document}"
                )
            values = strings(payload)
        else:
            values = PATH_PATTERN.findall(document.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise EvidenceRetentionError(
            f"cannot read authoritative document {document}: {error}"
        ) from error
    found: set[Path] = set()
    for value in values:
        if (
            document.suffix != ".json"
            and document.parent == project / "qa"
            and value.startswith("evidence/")
        ):
            # Markdown links in qa/ resolve to qa/evidence/, not build/evidence/.
            continue
        path = evidence_path(project, value)
        if path is not None:
            found.add(path)
        elif value.startswith(("build/evidence/", "evidence/")):
            raise EvidenceRetentionError(
                f"authoritative reference escapes evidence root: {value}"
            )
    return found


def inventory(project: Path) -> dict[str, object]:
    evidence = project / "build" / "evidence"
    if not evidence.is_dir() or evidence.is_symlink():
        raise EvidenceRetentionError(f"evidence root is missing or unsafe: {evidence}")
    all_files: set[Path] = set()
    for path in evidence.rglob("*"):
        if path.is_symlink():
            raise EvidenceRetentionError(f"symlinks are forbidden in evidence: {path}")
        if path.is_file():
            all_files.add(path.absolute())
    protected: set[Path] = set()
    queue = [project / relative for relative in ROOT_DOCUMENTS]
    # Stage reports are the authoritative indexes for historical browser runs.
    for stage in sorted(evidence.iterdir()):
        if stage.is_dir() and re.fullmatch(r"s\d+", stage.name):
            report = stage / "report.json"
            if not report.is_file() or report.is_symlink():
                raise EvidenceRetentionError(
                    f"stage evidence is missing a safe report.json: {stage}"
                )
            queue.append(report)
    missing_roots = [
        document for document in queue if not document.is_file() or document.is_symlink()
    ]
    if missing_roots:
        raise EvidenceRetentionError(
            "missing authoritative roots: "
            + ", ".join(path.relative_to(project).as_posix() for path in missing_roots)
        )
    seen_documents: set[Path] = set()
    while queue:
        document = queue.pop()
        resolved = document.absolute()
        if resolved in seen_documents:
            continue
        seen_documents.add(resolved)
        if resolved in all_files:
            protected.add(resolved)
        for target in references(document, project):
            if target not in all_files:
                raise EvidenceRetentionError(
                    f"authoritative reference is missing or unsafe: "
                    f"{target.relative_to(project).as_posix()}"
                )
            protected.add(target)
            if target.suffix == ".json":
                queue.append(target)

    candidates = sorted(all_files - protected)

    def relative(path: Path) -> str:
        return path.relative_to(project.resolve()).as_posix()

    return {
        "schemaVersion": 1,
        "mode": "dry-run",
        "evidenceRoot": "build/evidence",
        "total": {"files": len(all_files), "bytes": sum(p.stat().st_size for p in all_files)},
        "protected": {"files": len(protected & all_files), "bytes": sum(p.stat().st_size for p in protected & all_files)},
        "candidates": [
            {"path": relative(path), "bytes": path.stat().st_size}
            for path in candidates
        ],
        "candidateBytes": sum(path.stat().st_size for path in candidates),
        "authoritativeRoots": list(ROOT_DOCUMENTS) + ["build/evidence/s*/report.json"],
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project", type=Path, default=Path(__file__).resolve().parents[3])
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    project = args.project.resolve()
    try:
        result = inventory(project)
        if args.apply:
            evidence_root = (project / "build" / "evidence").resolve()
            verified_candidates: list[Path] = []
            for item in result["candidates"]:
                candidate = project / item["path"]
                if candidate.is_symlink() or not candidate.is_file():
                    raise EvidenceRetentionError(
                        f"candidate changed after inventory: {candidate}"
                    )
                try:
                    candidate.resolve(strict=True).relative_to(evidence_root)
                except (OSError, ValueError) as error:
                    raise EvidenceRetentionError(
                        f"candidate escaped evidence root after inventory: {candidate}"
                    ) from error
                verified_candidates.append(candidate)
            for candidate in verified_candidates:
                candidate.unlink()
            result["mode"] = "apply"
            result["removedFiles"] = len(result["candidates"])
    except EvidenceRetentionError as error:
        if args.json:
            print(
                json.dumps(
                    {"schemaVersion": 1, "mode": "blocked", "error": str(error)},
                    indent=2,
                )
            )
        else:
            print(f"blocked: {error}")
        return 2
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"{result['mode']}: {len(result['candidates'])} candidates, {result['candidateBytes']} bytes")
        for item in result["candidates"]:
            print(f"  {item['bytes']:>9}  {item['path']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
